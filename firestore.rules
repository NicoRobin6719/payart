rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isActiveAccount() {
      return signedIn();
    }

    function isArtist(userId) {
      return isActiveAccount()
        && get(/databases/$(database)/documents/profiles/$(userId)).data.role == 'artist';
    }

    match /superModerators/{userId} {
      allow read, write: if false;
    }

    match /moderators/{userId} {
      allow read, write: if false;
    }

    match /accountControls/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /profiles/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && isActiveAccount()
        && request.resource.data.role in ['artist', 'buyer'];
      allow update: if isOwner(userId)
        && isActiveAccount()
        && request.resource.data.role == resource.data.role
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'role',
          'bio',
          'avatar',
          'banner',
          'avatarPosition',
          'bannerPosition',
          'avatarFit',
          'bannerFit'
        ]);
      allow delete: if isOwner(userId) && isActiveAccount();

      match /favorites/{artworkId} {
        allow read, write: if isOwner(userId) && isActiveAccount();
      }

      match /cart/{artworkId} {
        allow read: if isOwner(userId) && isActiveAccount();
        allow create, update: if isOwner(userId)
          && isActiveAccount()
          && get(/databases/$(database)/documents/profiles/$(userId)).data.role == 'buyer'
          && request.resource.data.id == artworkId
          && request.resource.data.artistId is string
          && request.resource.data.artistId != userId
          && get(/databases/$(database)/documents/artworks/$(artworkId)).data.artistId
            == request.resource.data.artistId;
        allow delete: if isOwner(userId) && isActiveAccount();
      }
    }

    match /privateUsers/{userId} {
      allow read, write: if isOwner(userId) && isActiveAccount();
    }

    match /artworks/{artworkId} {
      allow read: if true;
      allow create: if isActiveAccount()
        && request.resource.data.artistId == request.auth.uid
        && request.resource.data.moderationStatus == 'approved'
        && isArtist(request.auth.uid);
      allow update: if signedIn()
        && isActiveAccount()
        && resource.data.artistId == request.auth.uid
        && resource.data.get('isSold', false) != true
        && request.resource.data.artistId == resource.data.artistId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'title',
            'description',
            'category',
            'price',
            'image',
            'artist',
            'shippingWidth',
            'shippingHeight',
            'shippingLength',
            'shippingWeight',
            'moderationStatus',
            'moderationReason'
          ])
        && request.resource.data.moderationStatus == 'approved';
      allow update: if signedIn()
        && isActiveAccount()
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'buyer'
        && resource.data.artistId != request.auth.uid
        && resource.data.get('isSold', false) != true

        && request.resource.data.isSold == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isSold']);
      allow delete: if signedIn()
        && isActiveAccount()
        && resource.data.artistId == request.auth.uid;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if signedIn()
        && isActiveAccount()
        && request.resource.data.accountId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 3
        && request.resource.data.text.size() <= 1000;
      allow delete: if signedIn() && isActiveAccount() && resource.data.accountId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if isActiveAccount() && request.auth.uid in resource.data.participants;
      allow create: if isActiveAccount()
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() == 2
        && request.resource.data.artworkId is string
        && get(/databases/$(database)/documents/artworks/$(request.resource.data.artworkId)).data.artistId
          in request.resource.data.participants;
      allow update: if isActiveAccount()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantNames'])
        && request.resource.data.participantNames[request.auth.uid] is string
        && request.resource.data.participantNames.diff(resource.data.participantNames)
          .affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if false;

      match /messages/{messageId} {
        function conversationIncludesUser() {
          return isActiveAccount()
            && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }

        allow read: if conversationIncludesUser();
        allow create: if conversationIncludesUser()
          && request.resource.data.fromId == request.auth.uid
          && request.resource.data.toId in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.toId != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 2
          && request.resource.data.text.size() <= 1000;
        allow update, delete: if false;
      }
    }

    match /orders/{orderId} {
      allow read: if isActiveAccount() && request.auth.uid in resource.data.participants;
      allow create: if isActiveAccount()
        && request.resource.data.buyerId == request.auth.uid
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'buyer'
        && request.resource.data.artistId != request.auth.uid
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.artistId in request.resource.data.participants
        && request.resource.data.artworkId is string
        && get(/databases/$(database)/documents/artworks/$(request.resource.data.artworkId)).data.artistId
          == request.resource.data.artistId

        && getAfter(/databases/$(database)/documents/artworks/$(request.resource.data.artworkId)).data.isSold == true
        && request.resource.data.amount
          == get(/databases/$(database)/documents/artworks/$(request.resource.data.artworkId)).data.price
        && request.resource.data.paymentMethod in ['pix', 'credit-card', 'bank-slip']
        && request.resource.data.status == 'simulated'
        && request.resource.data.artworkTitle is string
        && request.resource.data.artistName is string
        && request.resource.data.buyerName is string
        && request.resource.data.createdAt is string
        && request.resource.data.deliveryAddress is map
        && request.resource.data.deliveryAddress.recipient is string
        && request.resource.data.deliveryAddress.recipient.size() > 0
        && request.resource.data.deliveryAddress.postalCode is string
        && request.resource.data.deliveryAddress.postalCode.matches('^[0-9]{5}-?[0-9]{3}$')
        && request.resource.data.deliveryAddress.street is string
        && request.resource.data.deliveryAddress.street.size() > 0
        && request.resource.data.deliveryAddress.number is string
        && request.resource.data.deliveryAddress.number.size() > 0
        && request.resource.data.deliveryAddress.complement is string
        && request.resource.data.deliveryAddress.neighborhood is string
        && request.resource.data.deliveryAddress.neighborhood.size() > 0
        && request.resource.data.deliveryAddress.city is string
        && request.resource.data.deliveryAddress.city.size() > 0
        && request.resource.data.deliveryAddress.state is string
        && request.resource.data.deliveryAddress.state.matches('^[A-Z]{2}$');
      allow update, delete: if false;
    }

    match /demoWithdrawals/{withdrawalId} {
      allow read: if isActiveAccount()
        && resource.data.artistId == request.auth.uid;
      allow create: if isActiveAccount()
        && request.resource.data.artistId == request.auth.uid
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'artist'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 1000000
        && request.resource.data.commissionRate == 25
        && request.resource.data.status == 'simulated'
        && request.resource.data.createdAt is string
        && request.resource.data.keys().hasOnly([
          'artistId',
          'amount',
          'commissionRate',
          'status',
          'createdAt'
        ]);
      allow update, delete: if false;
    }
  }
}
